# -------------------------------------------------------------------
# Copy this file to ".env" (remove the .example) and fill in real values.
# This keeps passwords OUT of your code.
# -------------------------------------------------------------------

# Database connection. After you install PostgreSQL and create the
# database + user (see README), put the matching details here.
DATABASE_URL=postgresql://hcc:hcc@localhost:5432/hcc_erp

# A long random string used to secure logins. Generate one and paste it.
# (On Windows you can just mash the keyboard for ~40 characters for now.)
SECRET_KEY=change-me-to-a-long-random-string
